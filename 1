<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Simple Calculator</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      background: #f3f4f6;
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 60px;
    }
    .calculator {
      background: #fff;
      padding: 22px 20px 20px 20px;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
      width: 340px;
    }
    .calc-display {
      width: 100%;
      height: 50px;
      font-size: 1.6em;
      margin-bottom: 16px;
      padding: 8px 14px;
      background: #f8fafb;
      border: 1px solid #d3d9df;
      border-radius: 6px;
      text-align: right;
      box-sizing: border-box;
      color: #222;
    }
    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 64px);
      grid-gap: 10px;
    }
    button {
      padding: 18px 0;
      font-size: 1.2em;
      border: none;
      border-radius: 6px;
      background: #f1f3f8;
      color: #333;
      cursor: pointer;
      transition: background 0.16s;
    }
    button:active {
      background: #d2dee4;
    }
    .btn-operator {
      background: #4e6ef2;
      color: #fff;
    }
    .btn-equal {
      background: #10bc7e;
      color: #fff;
      grid-column: span 2;
    }
    .btn-clear {
      background: #f78b60;
      color: #fff;
    }
  </style>
</head>
<body>
  <div class="calculator">
    <input type="text" class="calc-display" id="display" disabled>
    <div class="buttons">
      <button class="btn-clear" onclick="clearDisplay()">C</button>
      <button onclick="inputValue('(')">(</button>
      <button onclick="inputValue(')')">)</button>
      <button class="btn-operator" onclick="inputValue('/')">÷</button>
      <button onclick="inputValue('7')">7</button>
      <button onclick="inputValue('8')">8</button>
      <button onclick="inputValue('9')">9</button>
      <button class="btn-operator" onclick="inputValue('*')">×</button>
      <button onclick="inputValue('4')">4</button>
      <button onclick="inputValue('5')">5</button>
      <button onclick="inputValue('6')">6</button>
      <button class="btn-operator" onclick="inputValue('-')">-</button>
      <button onclick="inputValue('1')">1</button>
      <button onclick="inputValue('2')">2</button>
      <button onclick="inputValue('3')">3</button>
      <button class="btn-operator" onclick="inputValue('+')">+</button>
      <button onclick="inputValue('0')">0</button>
      <button onclick="inputValue('.')">.</button>
      <button class="btn-equal" onclick="calculateResult()">=</button>
    </div>
  </div>
  <script>
    let display = document.getElementById('display');

    function inputValue(val) {
      display.value += val;
    }

    function clearDisplay() {
      display.value = '';
    }

    function calculateResult() {
      try {
        // Only allow safe characters for eval
        let allowed = /^[0-9+\-*/().\s]+$/;
        if (!allowed.test(display.value)) {
          display.value = 'Error';
          return;
        }
        display.value = eval(display.value);
      } catch {
        display.value = 'Error';
      }
    }

    // Allow keyboard input as a usability improvement
    document.addEventListener('keydown', function(e) {
      const key = e.key;
      if ('0123456789+-*/().'.includes(key)) {
        inputValue(key);
      } else if (key === 'Enter' || key === '=') {
        calculateResult();
        e.preventDefault();
      } else if (key === 'Backspace') {
        display.value = display.value.slice(0, -1);
      } else if (key.toLowerCase() === 'c') {
        clearDisplay();
      }
    });
  </script>
</body>
</html>